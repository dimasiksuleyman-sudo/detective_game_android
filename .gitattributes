* text=auto eol=lf
*.bat text eol=crlf
*.png binary
*.jar binary

# Исходники ассетов (art/) — в Git LFS (ADR-027). Готовые файлы игры в public/ — обычный git.
art/**/*.png filter=lfs diff=lfs merge=lfs -text
art/**/*.jpg filter=lfs diff=lfs merge=lfs -text
art/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
art/**/*.webp filter=lfs diff=lfs merge=lfs -text
art/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
art/**/*.wav filter=lfs diff=lfs merge=lfs -text

# Файлы, закоммиченные до перехода на LFS, остаются обычными (историю не переписываем).
